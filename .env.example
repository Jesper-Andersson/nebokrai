# Sign-in is optional: without these, words are saved in the browser only.
# Copy to .env and fill in. Either pair alone is enough.
# Redirect address to register at the provider: <site>/auth/callback/github (or /google).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# The report form's bot check (Cloudflare Turnstile) is off without a secret.
# To try it locally, use Cloudflare's test keys: the site's own key works on
# nebokrai.app only. These two always pass; a site key of
# 2x00000000000000000000AB always fails.
# TURNSTILE_SECRET=1x0000000000000000000000000000000AA
# TURNSTILE_SITE_KEY=1x00000000000000000000AA
