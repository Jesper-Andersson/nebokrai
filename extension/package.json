{
	"name": "nebokrai-extension",
	"version": "0.1.3",
	"private": true,
	"license": "AGPL-3.0-or-later",
	"type": "module",
	"scripts": {
		"dev": "wxt",
		"dev:firefox": "wxt -b firefox",
		"build": "wxt build && wxt build -b firefox",
		"zip": "wxt zip && wxt zip -b firefox",
		"check": "wxt prepare && svelte-check --tsconfig ./tsconfig.json",
		"test": "node --test \"tests/*.test.ts\"",
		"postinstall": "wxt prepare"
	},
	"devDependencies": {
		"@wxt-dev/module-svelte": "^2.0.5",
		"svelte": "^5.57.2",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"wxt": "^0.21.5"
	}
}
