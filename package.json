{
	"name": "nebokrai",
	"version": "0.0.1",
	"private": true,
	"license": "AGPL-3.0-or-later",
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc -p src/service-worker",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "node --test \"tests/*.test.ts\"",
		"reports": "node scripts/reports.ts",
		"og-image": "node scripts/og-image.ts",
		"app-icons": "node scripts/app-icons.ts",
		"shots": "node scripts/shots.ts",
		"deploy": "vite build && wrangler deploy"
	},
	"devDependencies": {
		"@sveltejs/adapter-cloudflare": "^8.0.2",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/node": "^22.0.0",
		"bits-ui": "^2.21.0",
		"melt": "^0.44.0",
		"svelte": "^5.57.2",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"wrangler": "^4.160.1"
	}
}
